datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id             String              @id @default(uuid())
  name           String
  industry       String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  products       Product[]
  branches       Branch[]
  purchases      Purchase[]
  sales          Sale[]
  auditFindings  AuditFinding[]
  stockChecks    StockCheck[]
  movements      InventoryMovement[]
  transactions   Transaction[]
  journalEntries JournalEntry[]
}

model Branch {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  products   Product[]
  movements  InventoryMovement[]
  purchases  Purchase[]
}

model Product {
  id               String              @id @default(uuid())
  businessId       String
  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name             String
  sku              String              @default("DEFAULT-SKU")
  category         String?             @default("Finished Goods")
  quantity         Float               @default(0)
  stock            Float               @default(0)
  stockLevel       Float               @default(0)
  minStockLevel    Float               @default(0)
  costPrice        Float               @default(0)
  unitCost         Float               @default(0)
  sellingPrice     Float               @default(0)
  unitPrice        Float               @default(0)
  price            Float               @default(0)
  wac              Float               @default(0)
  unitsPerCarton   Int                 @default(1)
  totalUnitsBought Float               @default(0)
  totalUnitsSold   Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  movements        InventoryMovement[]
  saleItems        SaleItem[]
  purchaseItems    PurchaseItem[]
  stockChecks      StockCheck[]

  @@unique([businessId, sku])
}

model InventoryMovement {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String   
  quantity    Float
  unitCost    Float    @default(0)
  referenceId String?
  notes       String?
  createdAt   DateTime @default(now())
}

model Purchase {
  id          String         @id @default(uuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplierId  String?
  reference   String?
  status      String?        @default("PAID")
  totalAmount Float          @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Float
  unitCost   Float    @default(0)
  subtotal   Float    @default(0)
}

model Sale {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  totalAmount Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  unitPrice Float    @default(0)
  unitCost  Float    @default(0)
  subtotal  Float    @default(0)
}

model AuditFinding {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String   @default("Audit Notice")
  severity    String   
  description String
  ruleType    String?
  amount      Float    @default(0)
  actionable  String?  
  createdAt   DateTime @default(now())
}

model StockCheck {
  id               String   @id @default(uuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedQty       Float    @default(0)
  systemQty        Float    @default(0)
  expectedPhysical Float    @default(0)
  actualPhysical   Float    @default(0)
  discrepancy      Float    @default(0)
  checkedAt        DateTime @default(now())
  createdAt        DateTime @default(now())
}

model Transaction {
  id              String   @id @default(uuid())
  businessId      String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount          Float    @default(0)
  type            String   
  status          String?  @default("COMPLETED")
  source          String?  @default("MANUAL")
  reference       String?
  description     String?
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model JournalEntry {
  id            String   @id @default(uuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reference     String?
  debitAccount  String?  @default("Inventory Asset")
  creditAccount String?  @default("Accounts Payable")
  description   String?
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}