datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id            String          @id @default(uuid())
  name          String
  industry      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  products      Product[]
  branches      Branch[]
  purchases     Purchase[]
  sales         Sale[]
  auditFindings AuditFinding[]
  stockChecks   StockCheck[]
  movements     InventoryMovement[]
}

model Branch {
  id         String   @id @default(uuid())
  businessId String
  business   Business @using(businessId) @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  products   Product[]
  movements  InventoryMovement[]
}

model Product {
  id            String              @id @default(uuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name          String
  sku           String
  category      String?             @default("Finished Goods")
  quantity      Float               @default(0)
  stockLevel    Float               @default(0)
  minStockLevel Float               @default(0)
  costPrice     Float               @default(0)
  unitCost      Float               @default(0)
  sellingPrice  Float               @default(0)
  wac           Float               @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     InventoryMovement[]
  saleItems     SaleItem[]
  stockChecks   StockCheck[]

  @@unique([businessId, sku])
}

model InventoryMovement {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       String   // e.g. OPENING_BALANCE, SALE, PURCHASE, ADJUSTMENT
  quantity   Float
  unitCost   Float    @default(0)
  notes      String?
  createdAt  DateTime @default(now())
}

model Purchase {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId  String?
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sale {
  id          String     @id @default(uuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  totalAmount Float      @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  unitPrice Float
  unitCost  Float    @default(0)
  subtotal  Float
}

model AuditFinding {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  severity    String   // HIGH, MEDIUM, LOW
  description String
  ruleType    String?
  actionable  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model StockCheck {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  countedQty Float
  systemQty  Float
  createdAt  DateTime @default(now())
}