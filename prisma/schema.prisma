datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id             String          @id @default(uuid())
  name           String
  currency       String          @default("NGN")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branches       Branch[]
  products       Product[]
  purchases      Purchase[]
  sales          Sale[]
  expenses       Expense[]
  journalEntries JournalEntry[]
  auditFindings  AuditFinding[]
}

model Branch {
  id         String              @id @default(uuid())
  businessId String
  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  location   String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  inventory  InventoryMovement[]
  purchases  Purchase[]
  sales      Sale[]
  expenses   Expense[]
}

model Product {
  id            String              @id @default(uuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sku           String
  name          String
  category      String?
  unitCost      Float               @default(0.0) // Weighted Average Cost (WAC)
  sellingPrice  Float               @default(0.0)
  stockLevel    Float               @default(0.0)
  minStockLevel Float               @default(5.0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movements     InventoryMovement[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@unique([businessId, sku])
}

model InventoryMovement {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      String   // IN, OUT, ADJUSTMENT
  quantity  Float
  unitCost  Float
  reference String?  // Purchase ID or Sale ID
  createdAt DateTime @default(now())
}

model Purchase {
  id           String         @id @default(uuid())
  businessId   String
  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierName String
  totalAmount  Float
  status       String         @default("COMPLETED")
  createdAt    DateTime       @default(now())
  items        PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Float
  unitCost   Float
  subtotal   Float
}

model Sale {
  id            String     @id @default(uuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerName  String?
  totalAmount   Float
  paymentMethod String     @default("CASH")
  createdAt     DateTime   @default(now())
  items         SaleItem[]
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Float
  unitPrice Float
  cogs      Float    @default(0.0) // COGS at time of sale based on WAC
  subtotal  Float
}

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    String   // Rent, Salaries, Utilities, etc.
  amount      Float
  description String?
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  account    String   // e.g. "Cash", "Inventory", "Sales", "COGS", "Expenses", "Accounts Payable"
  debit      Float    @default(0.0)
  credit     Float    @default(0.0)
  reference  String?  // Sale ID, Purchase ID, Expense ID
  createdAt  DateTime @default(now())
}

model AuditFinding {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  severity    String   // LOW, MEDIUM, HIGH, CRITICAL
  title       String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}